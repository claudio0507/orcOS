# ── Banco de dados ────────────────────────────────────────────────────────────
# Render.com: use a URL fornecida no painel "External Database URL"
# Local:      postgresql+asyncpg://orcos:orcos@localhost:5432/orcos
DATABASE_URL=postgresql+asyncpg://orcos:orcos@localhost:5432/orcos

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Em produção, liste apenas as origens permitidas (vírgulas):
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Sandbox ───────────────────────────────────────────────────────────────────
# true  → bypassar tenant ID e MFA; CORS wildcard; seeds disponíveis
# false → modo produção completo
SANDBOX_MODE=false
